# ==============================================================================
# ShopHub Environment Variables Template
# Copy this file to .env.local and adjust for your local or production environment
# ==============================================================================

# Hub CRM / Project-ERP API Target
# - Use https://hows.hubinterior.com for production CRM
# - Use http://localhost:8081 for local Spring Boot ERP (project-erp)
CRM_API_PROXY_TARGET=https://hows.hubinterior.com
ERP_API_BASE_URL=https://hows.hubinterior.com

# Optional: Service Auth Token for server-to-server ERP calls
# Format: token_<userId>_<timestamp>
ERP_AUTH_TOKEN=token_1_1710000000000

# Design Module Backend & Frontend URLs
DESIGN_MODULE_BASE_URL=https://api.hubinterior.com
NEXT_PUBLIC_DESIGN_MODULE_FRONTEND_URL=https://design.hubinterior.com
DESIGN_MODULE_FRONTEND_URL=https://design.hubinterior.com
# Read-only service token (dm_svc_…). Never a designer sess- and never "hi".
DESIGN_MODULE_TOKEN=

# Hub Quote & Proposal Service Base URL
HUB_CRM_QUOTE_BASE_URL=https://api.hubinterior.com

# ShopHub Product Catalog API (Spring on EC2). May be http:// — the browser never
# calls it directly on HTTPS Vercel pages; it uses /api/backend as a same-origin proxy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_BEARER_TOKEN=
# Used to mint a fresh catalog JWT for category create/update/delete
SPRING_AUTH_USERNAME=
SPRING_AUTH_PASSWORD=

# AWS S3 (product / profile images)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-2
S3_BUCKET_NAME=designmod
S3_KEY_PREFIX=shophub
# Optional override if the bucket uses a CloudFront / custom domain
# S3_PUBLIC_BASE_URL=https://designmod.s3.ap-south-2.amazonaws.com
